# ─── Snowflake Connection ─────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=su04169
SNOWFLAKE_USER=APPDEMO2
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# ─── Application Database & Schema ───────────────────────────────────────────
# Using APP_ prefix to avoid collision with runtime-set SNOWFLAKE_DATABASE/SCHEMA
APP_DATABASE=SME_ANALYTICS_LATINIBERIA_ENGINEERING
APP_SCHEMA=LAI_APP

# ─── Luminate Data Share (external shared database) ───────────────────────────
LUMINATE_DATABASE=luminate_db_listing_detail
LUMINATE_SCHEMA=extract_s

# ─── Streamlit Connection TTL (seconds) ──────────────────────────────────────
SNOWFLAKE_CONNECTION_TTL=600

# ─── Compute Pool (for SPCS-based Streamlit) ─────────────────────────────────
SNOWFLAKE_COMPUTE_POOL=SYSTEM_COMPUTE_POOL_CPU
